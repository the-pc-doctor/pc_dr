# Private denylist of real identifiers. Committing this would disclose
# exactly the values it exists to exclude. See SANITIZATION.md.
.denylist.local
denylist.txt

# Real variable values and anything rendered from them.
vars.yml
vars.*.yml
!vars.example.yml
rendered/
out/

# Credentials, keys, environment files.
*.pem
*.key
*.p12
*.crt
.env
.env.*
# Narrow, not wildcard. A broad `*credentials*` silently swallowed
# agent/lib/credentials.sh.tmpl — a legitimate template — and `git add -A`
# reported nothing. An ignore rule that quietly drops a file you meant to
# publish is a publication defect, so these name real artifacts only.
.credentials
*.credentials
credentials.json
credentials.yml
secrets.json
secrets.yml
*.secret
auth.json

# Live configuration accidentally dropped in the tree.
*.bak
*.bak.*
*.orig
*.live.yml
*.live.yaml

# Tooling noise.
__pycache__/
*.pyc
.DS_Store
._*
.venv/
