#!/usr/bin/env bash
# Runtime credential resolution.
#
# Doctrine: doctrine/operations/change-backup-and-rollback.md (one place to
# rotate), doctrine/knowledge/source-authority.md (fail loudly, never silently
# degrade to unauthenticated).
#
# The rule this exists to enforce: a secret is never a literal in a script, a
# command line, a config file, or a hook's injected context.
#
# Three distinct leak paths, all closed here:
#
#   1. IN THE FILE. A literal in a script is copied into every backup, every
#      version-control blob, and every editor history entry.
#
#   2. IN THE PROCESS LIST. `curl -u user:pass` puts the credential in argv,
#      which any local user can read from `ps`. Pass it on stdin instead.
#
#   3. IN THE TRANSCRIPT. A credential embedded in text that an agent harness
#      injects into model context is written into every stored session
#      transcript. This is the easiest one to miss and the hardest to clean up,
#      because the transcripts are numerous, long-lived, and not obviously
#      credential-bearing.
#
# shellcheck shell=bash

set -uo pipefail

CRED_FILE="${LAB_CREDENTIALS:-{{ credentials.file }}}"

# Resolve one secret. Format: `key = value`, one per line, anywhere in the file.
#
# Deliberately fails LOUDLY. A resolver that returns empty on failure produces
# unauthenticated requests, and an unauthenticated request usually comes back
# looking like "no results" rather than like an error — so the failure gets
# interpreted as data.
cred() {
  local key="$1" value
  if [[ ! -r "${CRED_FILE}" ]]; then
    echo "credentials: cannot read ${CRED_FILE}" >&2
    return 3
  fi
  value="$(sed -n "s/^${key}[[:space:]]*=[[:space:]]*//p" "${CRED_FILE}" 2>/dev/null | head -1)"
  if [[ -z "${value}" ]]; then
    echo "credentials: '${key}' not found in ${CRED_FILE}" >&2
    return 3
  fi
  printf '%s' "${value}"
}

# Soft variant for contexts that must never fail — a hook that could break the
# session, or a checkpointer that must not be able to break the work it records.
# Returns empty and lets the caller decide to stay silent.
cred_or_empty() {
  cred "$1" 2>/dev/null || printf ''
}

# Authenticated curl. Credentials go in on stdin via --config, never in argv.
#
#   cred_curl "user:pass" -X POST "$url" -H 'Content-Type: application/json' -d "$body"
cred_curl() {
  local auth="$1"; shift
  printf 'user = "%s"\n' "${auth}" | curl --config - "$@"
}
